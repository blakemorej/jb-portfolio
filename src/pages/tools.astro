---
// src/pages/tools.astro
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---

<Base
  title="Tools — Jonathan Blakemore"
  description="Free SEO tools built by Jonathan Blakemore."
>
  <Header />

  <main class="mx-auto max-w-4xl px-6 pb-20 pt-12">

    <a href="/" class="mb-8 inline-block text-sm text-accent hover:underline">← Back</a>

    <div class="mb-3 text-[10px] uppercase tracking-widest text-subtle">Free Tools</div>
    <h1 class="mb-4 text-4xl font-extrabold tracking-tight text-heading">Tools</h1>
    <p class="mb-10 max-w-lg text-base leading-relaxed text-muted">
      A small collection of tools I've built to make common SEO tasks faster. All free to use.
    </p>

    <div class="flex flex-col gap-4">

      <a
        href="https://hreflang-check.streamlit.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-lg border border-border bg-surface px-6 py-5 transition-colors hover:border-accent"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="mb-1.5 text-sm font-semibold text-heading">Hreflang Checker</div>
            <p class="text-sm leading-relaxed text-subtle">
              Extract the hreflang tags from any URL. Includes options to bypass website
              authentication — useful for reviewing staging environments before go-live.
            </p>
          </div>
          <div class="shrink-0 text-border transition-colors group-hover:text-accent">↗</div>
        </div>
      </a>

      <a
        href="https://sitemap-index-extractor.streamlit.app/"
        target="_blank"
        rel="noopener noreferrer"
        class="group rounded-lg border border-border bg-surface px-6 py-5 transition-colors hover:border-accent"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="mb-1.5 text-sm font-semibold text-heading">XML Sitemap Extractor</div>
            <p class="text-sm leading-relaxed text-subtle">
              Extract all URLs from an XML sitemap URL, including nested sitemap indexes.
              Optional authentication bypass for staging site review.
            </p>
          </div>
          <div class="shrink-0 text-border transition-colors group-hover:text-accent">↗</div>
        </div>
      </a>

    </div>

  </main>
</Base>
