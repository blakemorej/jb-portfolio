---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---

<Base
  title="Contact — Jonathan Blakemore"
  description="Get in touch with Jonathan Blakemore, SEO Manager."
>
  <Header />

  <main class="mx-auto max-w-2xl px-6 pb-20 pt-12">

    <a href="/" class="mb-8 inline-block text-sm text-accent hover:underline">← Back</a>

    <div class="mb-3 text-[10px] uppercase tracking-widest text-subtle">Get in touch</div>
    <h1 class="mb-4 text-4xl font-extrabold tracking-tight text-heading">Contact Me</h1>

    <p class="mb-10 max-w-lg text-base leading-relaxed text-muted">
      For all general enquiries, fill in the form below and I'll get back to you as soon as I can.
      I do take on a select number of freelance SEO clients — I'm particular about the projects I
      work on, but if you think yours could be a good fit, I'd genuinely love to hear about it.
    </p>

    <form action="https://formspree.io/f/REPLACE_WITH_YOUR_FORM_ID" method="POST" class="space-y-6">

      <div>
        <label for="name" class="mb-1.5 block text-sm font-medium text-muted">
          Name <span class="text-accent">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          placeholder="Your name"
          class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-sm text-heading placeholder:text-subtle focus:border-accent focus:outline-none"
        />
      </div>

      <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-muted">
          Email <span class="text-accent">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="you@example.com"
          class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-sm text-heading placeholder:text-subtle focus:border-accent focus:outline-none"
        />
      </div>

      <div>
        <label for="phone" class="mb-1.5 block text-sm font-medium text-muted">Phone Number</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="+44 7700 000000"
          class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-sm text-heading placeholder:text-subtle focus:border-accent focus:outline-none"
        />
      </div>

      <div>
        <label for="source" class="mb-1.5 block text-sm font-medium text-muted">How did you hear about me?</label>
        <select
          id="source"
          name="source"
          class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-sm text-heading focus:border-accent focus:outline-none"
        >
          <option value="">Select an option</option>
          <option value="LinkedIn">LinkedIn</option>
          <option value="Google / Search">Google / Search</option>
          <option value="Referral">Referral</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div>
        <label for="message" class="mb-1.5 block text-sm font-medium text-muted">
          Message <span class="text-accent">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="6"
          placeholder="All relevant details for reaching out, any questions you have, or your general reasons for enquiring..."
          class="w-full resize-none rounded-lg border border-border bg-surface px-4 py-3 text-sm text-heading placeholder:text-subtle focus:border-accent focus:outline-none"
        ></textarea>
      </div>

      <div>
        <label for="website" class="mb-1.5 block text-sm font-medium text-muted">Website URL</label>
        <input
          type="url"
          id="website"
          name="website"
          placeholder="https://yourwebsite.com"
          class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-sm text-heading placeholder:text-subtle focus:border-accent focus:outline-none"
        />
      </div>

      <button
        type="submit"
        class="rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-80"
      >
        Send Message →
      </button>

    </form>

    <div class="mt-12 border-t border-border pt-8">
      <a
        href="https://www.linkedin.com/in/jonathan-blakemore-70436a74/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-subtle transition-colors hover:text-accent"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        Connect on LinkedIn
      </a>
    </div>

  </main>
</Base>
