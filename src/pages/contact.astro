---
// src/pages/contact.astro
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---

<Base
  title="Contact — Jonathan Blakemore"
  description="Get in touch with Jonathan Blakemore, SEO Manager."
>
  <Header />

  <main class="flex-1 mx-auto w-full max-w-7xl px-10 max-md:px-5 py-12">

    <!-- Breadcrumb -->
    <div class="label-mono mb-6 text-dim">
      <a href="/" class="transition-colors hover:text-accent">Home</a>
      <span class="mx-2">/</span>
      <span class="text-hi">Contact</span>
    </div>

    <h1 class="mb-10 text-[clamp(36px,5vw,64px)] font-bold leading-tight tracking-tight text-hi">
      Contact<span class="text-accent">.</span>
    </h1>

    <!-- Split panel -->
    <div class="grid grid-cols-1 gap-px bg-line lg:grid-cols-[2fr_3fr]">

      <!-- Left: intro + social -->
      <div class="bg-surface p-8">
        <p class="mb-8 text-base leading-relaxed text-txt">
          For all general enquiries, fill in the form and I'll get back to you as soon as I can.
          I take on a select number of freelance SEO clients — I'm particular about the projects
          I work on, but if you think yours could be a good fit, I'd genuinely love to hear about it.
        </p>
        <div class="flex items-center gap-3">
          <span class="label-mono text-dim">Social</span>
          <a
            href="https://www.linkedin.com/in/jonathan-blakemore-70436a74/"
            target="_blank"
            rel="noopener noreferrer"
            class="label-mono text-accent transition-colors hover:text-accent-hover"
          >
            LinkedIn ↗
          </a>
        </div>
      </div>

      <!-- Right: form -->
      <div class="bg-surface p-8">
        <form action="https://formspree.io/f/mlgvdngb" method="POST" class="flex flex-col gap-5">

          <div>
            <label for="name" class="label-mono mb-2 block text-dim">
              Name <span class="text-accent">*</span>
            </label>
            <input
              type="text" id="name" name="name" required
              placeholder="Your name"
              class="w-full border border-line bg-bg px-4 py-3 text-sm text-hi placeholder:text-faint focus:border-accent focus:outline-none transition-colors"
            />
          </div>

          <div>
            <label for="email" class="label-mono mb-2 block text-dim">
              Email <span class="text-accent">*</span>
            </label>
            <input
              type="email" id="email" name="email" required
              placeholder="you@example.com"
              class="w-full border border-line bg-bg px-4 py-3 text-sm text-hi placeholder:text-faint focus:border-accent focus:outline-none transition-colors"
            />
          </div>

          <div>
            <label for="source" class="label-mono mb-2 block text-dim">
              How did you hear about me?
            </label>
            <select
              id="source" name="source"
              class="w-full border border-line bg-bg px-4 py-3 text-sm text-hi focus:border-accent focus:outline-none transition-colors"
            >
              <option value="">Select an option</option>
              <option value="LinkedIn">LinkedIn</option>
              <option value="Google / Search">Google / Search</option>
              <option value="Referral">Referral</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div>
            <label for="message" class="label-mono mb-2 block text-dim">
              Message <span class="text-accent">*</span>
            </label>
            <textarea
              id="message" name="message" required rows="6"
              placeholder="All relevant details for reaching out..."
              class="w-full resize-none border border-line bg-bg px-4 py-3 text-sm text-hi placeholder:text-faint focus:border-accent focus:outline-none transition-colors"
            ></textarea>
          </div>

          <div>
            <button
              type="submit"
              class="label-mono bg-accent px-6 py-3 text-on-accent transition-colors hover:bg-accent-hover"
            >
              Send Message →
            </button>
          </div>

        </form>
      </div>

    </div>
  </main>
</Base>
