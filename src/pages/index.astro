---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---

<Base
  title="Jonathan Blakemore — SEO Manager"
  description="Jonathan Blakemore is an SEO Manager with 10 years of experience in technical SEO, content strategy, and performance reporting."
>
  <Header />

  <main class="mx-auto max-w-4xl px-6 pb-20 pt-12">

    <!-- Hero -->
    <section class="mb-14 border-b border-border pb-14">
      <div class="flex items-end justify-between gap-8">
        <div class="flex-1">
          <div class="mb-3 text-[10px] uppercase tracking-widest text-subtle">SEO Manager · Chester, UK</div>
          <h1 class="mb-4 text-5xl font-extrabold leading-tight tracking-tight text-heading">
            Jonathan<br />Blakemore
          </h1>
          <p class="max-w-sm text-base leading-relaxed text-muted">
            I grow organic traffic through technical SEO, content strategy, and data-driven reporting.
            10 years in search — currently at Corsair Components directing organic across four global brands.
          </p>
        </div>
        <img
          src="/images/jonathan-blakemore-on-ice-square.png"
          alt="Jonathan Blakemore"
          class="h-64 w-64 shrink-0 object-contain"
        />
      </div>
    </section>

    <!-- Services -->
    <section class="mb-12">
      <div class="mb-6 text-[10px] uppercase tracking-widest text-subtle">What I Do</div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">

        <div class="rounded-lg border border-border bg-surface px-5 py-4">
          <div class="mb-1.5 text-sm font-semibold text-heading">Technical SEO</div>
          <p class="text-sm leading-relaxed text-subtle">
            Site architecture, crawl optimisation, indexation, structured data, and large-scale
            technical audits across e-commerce and SaaS platforms.
          </p>
        </div>

        <div class="rounded-lg border border-border bg-surface px-5 py-4">
          <div class="mb-1.5 text-sm font-semibold text-heading">GEO / AEO</div>
          <p class="text-sm leading-relaxed text-subtle">
            Optimising content and site structure for AI-powered search, answer engines, and
            large language model visibility.
          </p>
        </div>

        <div class="rounded-lg border border-border bg-surface px-5 py-4">
          <div class="mb-1.5 text-sm font-semibold text-heading">Content Marketing</div>
          <p class="text-sm leading-relaxed text-subtle">
            Keyword research, content strategy, topical authority, and editorial SEO training
            to build compounding organic traffic over time.
          </p>
        </div>

        <div class="rounded-lg border border-border bg-surface px-5 py-4">
          <div class="mb-1.5 text-sm font-semibold text-heading">Site Speed & Core Web Vitals</div>
          <p class="text-sm leading-relaxed text-subtle">
            Diagnosing and resolving LCP, INP, and CLS issues to achieve Good ratings across
            desktop and mobile — across Shopify, Magento, and custom stacks.
          </p>
        </div>

        <div class="rounded-lg border border-border bg-surface px-5 py-4">
          <div class="mb-1.5 text-sm font-semibold text-heading">International SEO</div>
          <p class="text-sm leading-relaxed text-subtle">
            Hreflang implementation, multiregional site architecture, and international
            content strategy across 20+ regions and 12 languages.
          </p>
        </div>

        <div class="rounded-lg border border-border bg-surface px-5 py-4">
          <div class="mb-1.5 text-sm font-semibold text-heading">Analytics & Reporting</div>
          <p class="text-sm leading-relaxed text-subtle">
            GA4, Google Search Console, and Ahrefs reporting built into Looker Studio dashboards
            stakeholders can self-serve without pulling me in monthly.
          </p>
        </div>

      </div>
    </section>

    <!-- Work History -->
    <section class="mb-12">
      <div class="mb-6 text-[10px] uppercase tracking-widest text-subtle">Work History</div>
      <div class="space-y-8">

        <div class="flex gap-5">
          <div class="w-28 shrink-0 text-[11px] text-subtle">Aug 2023 – Present</div>
          <div>
            <div class="text-sm font-semibold text-heading">SEO Manager</div>
            <div class="mb-2 text-sm text-muted">Corsair Components Limited</div>
            <p class="text-sm leading-relaxed text-subtle">
              Directing technical SEO strategy across CORSAIR, Elgato, SCUF, and Fanatec.
              20 regions, 12 languages. Post-migration recovery, international SEO, blog growth,
              Core Web Vitals, Looker Studio dashboards.
            </p>
          </div>
        </div>

        <div class="flex gap-5">
          <div class="w-28 shrink-0 text-[11px] text-subtle">Nov 2017 – Jul 2023</div>
          <div>
            <div class="text-sm font-semibold text-heading">Technical SEO Executive</div>
            <div class="mb-2 text-sm text-muted">We Influence / Velstar</div>
            <p class="text-sm leading-relaxed text-subtle">
              Technical SEO for a portfolio of diverse clients. Audits, keyword research,
              competitor analysis, CMS migrations, client reporting. Managed junior
              executive workflow and training.
            </p>
          </div>
        </div>

        <div class="flex gap-5">
          <div class="w-28 shrink-0 text-[11px] text-subtle">Jun 2015 – Nov 2017</div>
          <div>
            <div class="text-sm font-semibold text-heading">Senior Digital Marketing Executive</div>
            <div class="mb-2 text-sm text-muted">Aqueous Digital</div>
            <p class="text-sm leading-relaxed text-subtle">
              Full digital marketing mix — SEO, content, paid search (Google & Bing), CRO,
              link building, and online reputation management.
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Education -->
    <section class="mb-12">
      <div class="mb-6 text-[10px] uppercase tracking-widest text-subtle">Education</div>
      <div class="space-y-4">
        <div class="flex gap-5">
          <div class="w-28 shrink-0 text-[11px] text-subtle">2011 – 2014</div>
          <div>
            <div class="text-sm font-semibold text-heading">University of Chester</div>
            <div class="text-sm text-muted">Information Systems Management, 2:1</div>
          </div>
        </div>
        <div class="flex gap-5">
          <div class="w-28 shrink-0 text-[11px] text-subtle">2022</div>
          <div>
            <div class="text-sm font-semibold text-heading">Zero to Mastery</div>
            <div class="text-sm text-muted">Complete Python Developer — Certificate of Completion</div>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-border pt-6 flex gap-6">
      <a href="/case-studies" class="text-sm text-accent hover:underline">View case studies →</a>
      <a href="/tools" class="text-sm text-accent hover:underline">View tools →</a>
    </div>

  </main>
</Base>
