---
// src/pages/case-studies/[slug].astro
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import StatBadge from '../../components/StatBadge.astro';
import ChartLoader from '../../components/ChartLoader.astro';
import { getCaseStudySlugs, getCaseStudyConfig, getCaseStudyCSV } from '../../utils/getCaseStudies';
import { parseAhrefsCSV } from '../../utils/parseAhrefsCSV';

export async function getStaticPaths() {
  return getCaseStudySlugs().map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const config = getCaseStudyConfig(slug!);
const data   = parseAhrefsCSV(getCaseStudyCSV(slug!));
---

<Base title={`${config.client} — ${config.headline} | Jonathan Blakemore`} description={config.intro}>
  <Header />

  <main class="flex-1 mx-auto w-full max-w-7xl px-10 max-md:px-5 py-12">

    <!-- Back + breadcrumb -->
    <div class="label-mono mb-4 text-dim">
      <a href="/case-studies" class="transition-colors hover:text-accent">← Back</a>
    </div>
    <div class="label-mono mb-8 flex items-center gap-2 text-dim">
      <a href="/" class="transition-colors hover:text-accent">Home</a>
      <span>/</span>
      <a href="/case-studies" class="transition-colors hover:text-accent">Case Studies</a>
      <span>/</span>
      <span class="text-hi">{config.client}</span>
    </div>

    <!-- Hero -->
    <h1 class="mb-6 text-[clamp(40px,6vw,80px)] font-bold uppercase leading-none tracking-tight text-hi">
      {config.client}<span class="text-accent">.</span>
    </h1>
    <p class="mb-12 max-w-2xl text-base leading-relaxed text-txt">
      {config.intro}
    </p>

    <!-- Stat grid -->
    <div class="mb-16 grid grid-cols-2 gap-px bg-line lg:grid-cols-4">
      {config.stats.map(stat => (
        <div class="bg-surface px-6">
          <StatBadge value={stat.value} label={stat.label} />
        </div>
      ))}
    </div>

    <!-- Performance Data -->
    <section class="mb-16">
      <div class="mb-6 flex items-center gap-4 border-b border-line pb-4">
        <span class="font-mono text-xs text-accent">[01]</span>
        <span class="label-mono text-dim">Performance Data</span>
        <span class="flex-1 border-t border-line"></span>
        <span class="label-mono text-dim">Source · Ahrefs</span>
      </div>
      <ChartLoader
        data={data}
        startDate={config.startDate}
        migrationDate={config.migrationDate}
      />
    </section>

    <!-- What I Did -->
    <section class="mb-16">
      <div class="mb-6 flex items-center gap-4 border-b border-line pb-4">
        <span class="font-mono text-xs text-accent">[02]</span>
        <span class="label-mono text-dim">What I Did</span>
        <span class="flex-1 border-t border-line"></span>
      </div>
      <div class="flex flex-col gap-px bg-line">
        {config.bullets.map((bullet, i) => (
          <div class="flex gap-8 bg-surface px-6 py-6 max-sm:flex-col max-sm:gap-2">
            <div class="w-8 shrink-0 font-mono text-sm text-accent">
              {String(i + 1).padStart(2, '0')}
            </div>
            <div>
              <div class="mb-2 text-base font-semibold text-hi">{bullet.lead}</div>
              <p class="text-sm leading-relaxed text-txt">{bullet.body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Footer strip -->
    <div class="flex items-center justify-between border-t border-line pt-6">
      <span class="label-mono text-dim">Jonathan Blakemore · SEO Manager</span>
      <a href="/case-studies" class="label-mono text-dim transition-colors hover:text-accent">
        ← All case studies
      </a>
    </div>

  </main>
</Base>
