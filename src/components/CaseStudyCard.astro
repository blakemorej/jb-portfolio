---
// src/components/CaseStudyCard.astro
import type { CaseStudyConfig } from '../utils/getCaseStudies';
import { formatDateRange } from '../utils/formatDate';

export interface Props {
  config: CaseStudyConfig;
  index: number;
}

const { config, index } = Astro.props;
const dateRange = formatDateRange(config.startDate, config.endDate);
const stat = config.stats[0];
---

<a
  href={`/case-studies/${config.slug}`}
  class="group flex items-center gap-6 border-t border-line bg-surface px-6 py-5 transition-colors hover:bg-surface-raised"
>
  <!-- Index -->
  <div class="w-8 shrink-0 font-mono text-xs text-accent">
    {String(index).padStart(2, '0')}
  </div>

  <!-- Client + meta -->
  <div class="flex-1 min-w-0">
    <div class="text-xl font-bold tracking-tight text-hi">{config.client}</div>
    <div class="label-mono mt-1 text-dim">{config.industry} · {dateRange}</div>
  </div>

  <!-- Headline stat -->
  <div class="shrink-0 text-right">
    <div class="text-2xl font-bold text-accent leading-none">{stat.value}</div>
    <div class="label-mono mt-1 text-dim">{stat.label}</div>
  </div>

  <!-- Arrow -->
  <div class="shrink-0 text-dim transition-colors group-hover:text-accent">→</div>
</a>
