---
// src/components/ChartLoader.astro
import type { DataPoint } from '../utils/parseAhrefsCSV';
import { formatYearMonth } from '../utils/formatDate';

export interface Props {
  data: DataPoint[];
  startDate: string;
  migrationDate?: string;
}

const { data, startDate, migrationDate } = Astro.props;

const startIndex     = data.findIndex(d => d.date === startDate);
const migrationIndex = migrationDate ? data.findIndex(d => d.date === migrationDate) : -1;
const startLabel     = formatYearMonth(startDate);
const migrationLabel = migrationDate ? formatYearMonth(migrationDate) : '';

const chartPayload = JSON.stringify({ data, startIndex, migrationIndex, startLabel, migrationLabel });
---

<!-- Embedded data payload -->
<script type="application/json" id="chart-payload" set:html={chartPayload}></script>

<!-- 2×2 grid: 3 charts + 1 data-source note -->
<div class="grid grid-cols-1 gap-px bg-line sm:grid-cols-2">

  <!-- Chart 1: Non-brand traffic -->
  <div class="bg-surface p-5">
    <div class="label-mono mb-4 text-dim">Non-Brand Traffic</div>
    <canvas id="chart-nb"></canvas>
    <div class="mt-3 flex flex-wrap gap-4">
      <span class="label-mono flex items-center gap-1.5 text-dim">
        <span class="inline-block h-px w-4 bg-accent"></span>Non-Brand
      </span>
      <span class="label-mono flex items-center gap-1.5 text-dim">
        <span class="inline-block h-px w-4 border-t border-dashed border-amber"></span>Joined
      </span>
    </div>
  </div>

  <!-- Chart 2: Total organic traffic -->
  <div class="bg-surface p-5">
    <div class="label-mono mb-4 text-dim">Total Organic Traffic</div>
    <canvas id="chart-total"></canvas>
    <div class="mt-3 flex flex-wrap gap-4">
      <span class="label-mono flex items-center gap-1.5 text-dim">
        <span class="inline-block h-px w-4 bg-hi"></span>Total
      </span>
      {migrationLabel && (
        <span class="label-mono flex items-center gap-1.5 text-dim">
          <span class="inline-block h-px w-4 border-t border-dashed border-red"></span>Migration
        </span>
      )}
      <span class="label-mono flex items-center gap-1.5 text-dim">
        <span class="inline-block h-px w-4 border-t border-dashed border-amber"></span>Joined
      </span>
    </div>
  </div>

  <!-- Chart 3: Keyword rankings -->
  <div class="bg-surface p-5">
    <div class="label-mono mb-4 text-dim">Keyword Rankings</div>
    <canvas id="chart-kw"></canvas>
    <div class="mt-3 flex flex-wrap gap-4">
      <span class="label-mono flex items-center gap-1.5 text-dim">
        <span class="inline-block h-px w-4 bg-accent"></span>Pos 1–3
      </span>
      <span class="label-mono flex items-center gap-1.5 text-dim">
        <span class="inline-block h-px w-4 bg-dim"></span>Pos 4–10
      </span>
      <span class="label-mono flex items-center gap-1.5 text-dim">
        <span class="inline-block h-px w-4 border-t border-dashed border-amber"></span>Joined
      </span>
    </div>
  </div>

  <!-- Panel 4: Data source note -->
  <div class="bg-surface p-5 flex flex-col">
    <div class="label-mono mb-3 text-accent">// A note on data source.</div>
    <p class="text-sm leading-relaxed text-txt">
      Ahrefs traffic estimates are widely known to undercount real performance —
      actual organic visits consistently run higher than what Ahrefs reports.
      I've deliberately chosen to use Ahrefs data here rather than sharing real
      analytics from a current employer or past client. The trends shown are
      directionally accurate. The real numbers are better.
    </p>
  </div>

</div>

<script>
  import Chart from 'chart.js/auto';
  import annotationPlugin from 'chartjs-plugin-annotation';

  Chart.register(annotationPlugin);

  const payload = JSON.parse(document.getElementById('chart-payload')!.textContent!);
  const { data, startIndex, migrationIndex, startLabel, migrationLabel } = payload;

  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const labels: string[] = data.map((d: { date: string }) => {
    const [y, m] = d.date.split('-');
    return `${MONTHS[parseInt(m) - 1]} ${y.slice(2)}`;
  });

  const fmtK = (v: number) =>
    v >= 1_000_000 ? `${(v / 1_000_000).toFixed(1)}M`
    : v >= 1_000   ? `${Math.round(v / 1_000)}k`
    : String(v);

  const MONO = "'IBM Plex Mono'";

  const TIP = {
    backgroundColor: '#0e1014',
    borderColor:     '#1b1f26',
    borderWidth:     1,
    borderRadius:    0,
    titleColor:      '#5b6470',
    bodyColor:       '#eef2f7',
    padding:         12,
    titleFont: { family: MONO, size: 10 },
    bodyFont:  { family: MONO, size: 11 },
  };

  const SCALES = {
    x: {
      ticks: { color: '#5b6470', font: { family: MONO, size: 9 }, maxTicksLimit: 8, maxRotation: 0 },
      grid:   { color: '#1b1f26' },
      border: { color: '#1b1f26' },
    },
    y: {
      ticks: { color: '#5b6470', font: { family: MONO, size: 9 }, callback: fmtK },
      grid:   { color: '#1b1f26' },
      border: { color: '#1b1f26' },
    },
  };

  function ds(values: number[], color: string, fill = false) {
    return {
      data: values,
      borderColor: color,
      backgroundColor: fill ? `${color}1a` : 'transparent',
      fill,
      tension: 0.35,
      pointRadius: 0,
      pointHoverRadius: 4,
      pointHoverBackgroundColor: color,
      borderWidth: 1.5,
    };
  }

  function join() {
    return { type: 'line' as const, xMin: startIndex, xMax: startIndex,
             borderColor: '#f59e0b', borderWidth: 1, borderDash: [4, 4] };
  }
  function mig() {
    return { type: 'line' as const, xMin: migrationIndex, xMax: migrationIndex,
             borderColor: '#f87171', borderWidth: 1, borderDash: [4, 4] };
  }

  function opts(annotations: Record<string, object>) {
    return {
      animation: false,
      responsive: true,
      interaction: { mode: 'index' as const, intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: { ...TIP, callbacks: { label: (ctx: any) => `  ${ctx.parsed.y.toLocaleString()}` } },
        annotation: { annotations },
      },
      scales: SCALES,
    };
  }

  // Chart 1 — Non-brand traffic
  new Chart(document.getElementById('chart-nb') as HTMLCanvasElement, {
    type: 'line',
    data: { labels, datasets: [ds(data.map((d: any) => d.nonBranded), '#38bdf8', true)] },
    options: opts({ join: join() }),
  });

  // Chart 2 — Total organic
  const totalAnnotations: Record<string, object> = { join: join() };
  if (migrationIndex >= 0) totalAnnotations.mig = mig();

  new Chart(document.getElementById('chart-total') as HTMLCanvasElement, {
    type: 'line',
    data: { labels, datasets: [ds(data.map((d: any) => d.organicTraffic), '#eef2f7')] },
    options: opts(totalAnnotations),
  });

  // Chart 3 — Keyword rankings
  new Chart(document.getElementById('chart-kw') as HTMLCanvasElement, {
    type: 'line',
    data: {
      labels,
      datasets: [
        { ...ds(data.map((d: any) => d.pos1to3),  '#38bdf8'), label: 'Pos 1–3' },
        { ...ds(data.map((d: any) => d.pos4to10), '#5b6470'), label: 'Pos 4–10' },
      ],
    },
    options: {
      ...opts({ join: join() }),
      plugins: {
        ...opts({ join: join() }).plugins,
        tooltip: {
          ...TIP,
          callbacks: { label: (ctx: any) => `  ${ctx.dataset.label}: ${ctx.parsed.y.toLocaleString()}` },
        },
      },
    },
  });
</script>
