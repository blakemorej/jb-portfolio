    <a href="/" class="text-base font-extrabold tracking-tight text-accent">
      JB
    </a>
    <nav class="flex items-center gap-6">
      <a href="/case-studies" class="text-sm text-subtle transition-colors hover:text-muted">
        Case Studies
      </a>
      <a href="/tools" class="text-sm text-subtle transition-colors hover:text-muted">
        Tools
      </a>
      <a
        href="/contact"
        class="rounded-md border border-border bg-surface px-3 py-1.5 text-xs text-accent transition-colors hover:border-accent"
      >
        Contact
      </a>
    </nav>
  </div>
</header>
