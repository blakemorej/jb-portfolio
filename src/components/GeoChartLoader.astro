---
// src/components/GeoChartLoader.astro
import type { AiDataPoint } from '../utils/parseAiCompetitorCSV';

export interface Props {
  data: AiDataPoint[];
}

const { data } = Astro.props;

const platforms = ['ChatGPT', 'Gemini', 'Perplexity'];
const sites = [...new Set(data.map(d => d.site))]; // preserves order: CORSAIR first

const PALETTE = ['#38bdf8', '#818cf8', '#5b6470', '#3d454f'];
const siteColors = sites.map((site, i) => ({ site, color: PALETTE[i] ?? '#3d454f' }));

function seriesFor(metric: 'responses' | 'pages') {
  return sites.map(site =>
    platforms.map(platform => {
      const point = data.find(d => d.site === site && d.platform === platform);
      return point?.[metric] ?? 0;
    })
  );
}

const responseSeries = seriesFor('responses');
const pagesSeries    = seriesFor('pages');

const payload = JSON.stringify({
  platforms,
  siteColors: Object.fromEntries(siteColors.map(({ site, color }) => [site, color])),
  responseSeries,
  pagesSeries,
});
---

<script type="application/json" id="geo-chart-payload" set:html={payload}></script>

<div class="grid grid-cols-1 gap-px bg-line sm:grid-cols-2">

  <div class="bg-surface p-5">
    <div class="label-mono mb-4 text-dim">AI Responses Mentioning Brand</div>
    <canvas id="geo-chart-responses"></canvas>
  </div>

  <div class="bg-surface p-5">
    <div class="label-mono mb-4 text-dim">Pages Cited by AI</div>
    <canvas id="geo-chart-pages"></canvas>
  </div>

</div>

<!-- Legend rendered in template so Tailwind classes are included in build -->
<div class="flex flex-wrap items-center gap-x-6 gap-y-2 bg-surface px-5 pb-5 pt-3">
  {siteColors.map(({ site, color }) => (
    <span class="label-mono flex items-center gap-2 text-dim">
      <span style={`display:inline-block;width:10px;height:10px;background:${color};flex-shrink:0;`}></span>
      {site}
    </span>
  ))}
</div>

<script>
  import Chart from 'chart.js/auto';

  const { platforms, siteColors, responseSeries, pagesSeries } = JSON.parse(
    document.getElementById('geo-chart-payload')!.textContent!
  );

  const sites = Object.keys(siteColors);

  const MONO = "'IBM Plex Mono'";

  const TIP = {
    backgroundColor: '#0e1014',
    borderColor:     '#1b1f26',
    borderWidth:     1,
    borderRadius:    0,
    titleColor:      '#5b6470',
    bodyColor:       '#eef2f7',
    padding:         12,
    titleFont: { family: MONO, size: 10 },
    bodyFont:  { family: MONO, size: 11 },
  };

  const SCALES = {
    x: {
      ticks: { color: '#5b6470', font: { family: MONO, size: 9 }, maxRotation: 0 },
      grid:   { color: '#1b1f26' },
      border: { color: '#1b1f26' },
    },
    y: {
      ticks: {
        color: '#5b6470',
        font:  { family: MONO, size: 9 },
        callback: (v: number | string) => {
          const n = Number(v);
          return n >= 1000 ? `${Math.round(n / 1000)}k` : String(n);
        },
      },
      grid:   { color: '#1b1f26' },
      border: { color: '#1b1f26' },
    },
  };

  function buildDatasets(series: number[][]) {
    return sites.map((site: string, i: number) => ({
      label:           site,
      data:            series[i],
      backgroundColor: siteColors[site],
      borderColor:     siteColors[site],
      borderWidth:     0,
      borderRadius:    0,
    }));
  }

  function chartOpts() {
    return {
      animation: false,
      responsive: true,
      plugins: {
        legend: { display: false },
        tooltip: {
          ...TIP,
          callbacks: {
            label: (ctx: any) => `  ${ctx.dataset.label}: ${ctx.parsed.y.toLocaleString()}`,
          },
        },
      },
      scales: SCALES,
    };
  }

  new Chart(document.getElementById('geo-chart-responses') as HTMLCanvasElement, {
    type: 'bar',
    data: { labels: platforms, datasets: buildDatasets(responseSeries) },
    options: chartOpts(),
  });

  new Chart(document.getElementById('geo-chart-pages') as HTMLCanvasElement, {
    type: 'bar',
    data: { labels: platforms, datasets: buildDatasets(pagesSeries) },
    options: chartOpts(),
  });
</script>
