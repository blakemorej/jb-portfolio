---
// src/components/StatBadge.astro
export interface Props {
  value: string;
  label: string;
  period?: string;
}

const { value, label } = Astro.props;

// Split value into: leading symbols | digits+punctuation | trailing symbols
const m = value.match(/^([^0-9]*)([0-9][0-9,\.]*)(.*)$/);
const pre  = m?.[1] ?? '';
const num  = m?.[2] ?? value;
const suf  = m?.[3] ?? '';
---

<div class="flex flex-col py-6">
  <div class="whitespace-nowrap font-bold leading-none tracking-tight text-[clamp(26px,5.5vw,40px)]">
    {pre && <span class="text-accent">{pre}</span>}
    <span class="text-hi">{num}</span>
    {suf && <span class="text-accent">{suf}</span>}
  </div>
  <div class="label-mono mt-2 text-dim">{label}</div>
</div>
